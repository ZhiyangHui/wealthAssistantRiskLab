#!/bin/sh
# Run the complete benchmark using the repository's virtual environment.
set -eu
cd "$(dirname "$0")"
if [ ! -x .venv/bin/python ]; then
    echo "Set up .venv first; see README.md." >&2
    exit 2
fi
if [ "$#" -gt 1 ]; then
    echo "Usage: ./run [case ID|all|partB|plan]" >&2
    exit 2
fi
# Inspect the expanded matrix without credentials, output files or model calls.
if [ "${1:-all}" = plan ]; then
    exec .venv/bin/python -m riskLab --plan
fi
# The containment-only command never loads credentials or calls a hosted model.
if [ "${1:-all}" = partB ]; then
    exec .venv/bin/python -m riskLab.manage
fi
# A full evaluation omits the single-case filter.
if [ "${1:-all}" = all ]; then
    exec .venv/bin/python -m riskLab --deepseek deepseek-flash
fi
exec .venv/bin/python -m riskLab --deepseek deepseek-flash --case "$1"
